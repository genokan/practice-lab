# Terraform working data and state can contain machine details and cloud-init inputs.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!terraform.tfvars.example

# Generated control-plane access material.
infra/ansible/inventory/*.ini
infra/ansible/inventory/*.yaml
infra/ansible/inventory/*.yml
infra/ansible/inventory/host_vars/
infra/ansible/inventory/group_vars/
infra/ansible/.local/
.ansible/
artifacts/
kubeconfig/
*.kubeconfig

# Elixir build and dependency outputs are local-only.
apps/*/_build/
apps/*/deps/
apps/*/.elixir_ls/

# Credentials and local environment files must never enter the public repository.
.env
.env.*
!.env.example
*.pem
*.key
